{
  "name": "cac-url-backend",
  "version": "2.0.0",
  "description": "URL Shortener API with Neon.tech PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "echo 'Build complete'",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:sync": "node -e \"require('./config/database').sync({ alter: true }).then(() => console.log('DB synced')).catch(console.error)\"",
    "db:test": "node -e \"require('./config/database').testConnection().then(() => process.exit(0)).catch(() => process.exit(1))\""
  },
  "keywords": [
    "url-shortener",
    "api",
    "neon",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "geoip-lite": "^1.4.10",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "ua-parser-js": "^2.0.9"
  }
}